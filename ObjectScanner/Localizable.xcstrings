    "Odanın yapısını çıkarır": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Captures the room's structure"
          }
        }
      }
    },
    "Odanın çevresini kesintisiz dolaşıp başladığın yere dön. Yarım tur kalan duvarları eksik bırakır.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk the room's perimeter without stopping and return to where you started. Half a loop leaves the remaining walls incomplete."
          }
        }
      }
    },
    "Odağı Kilitle": {
      "extractionState": "manual",
      "localizations": {
