    "Obje düz ve desensiz. Fotogrametri geometriyi yüzey deseninden türetir, desen yoksa mesh yumuşayıp detay kaybolur. TrueDepth aktif IR aydınlatma yaptığı için görünümden bağımsız ölçüm alır.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The object is flat and featureless. Photogrammetry derives geometry from surface pattern, and without pattern the mesh softens and detail is lost. TrueDepth uses active IR illumination, so it measures independently of appearance."
          }
        }
      }
    },
    "Object Capture bu cihazda desteklenmiyor. LiDAR'lı bir iPhone/iPad Pro gerekiyor.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Object Capture is not supported on this device. A LiDAR-equipped iPhone or iPad Pro is required."
          }
        }
      }
    },
    "Objenin etrafında yavaşça dönün": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Orbit slowly around the object"
          }
        }
      }
    },
    "Objeye yaklaşın": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move closer to the object"
          }
        }
      }
    },
    "Objeyi 20–100 cm mesafede tutup yavaşça tarayın": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the object 20–100 cm away and scan slowly"
          }
        }
      }
    },
    "Objeyi Kilitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
