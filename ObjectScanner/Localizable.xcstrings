          }
        }
      }
    },
    "Yüzeyde eşleşmeye yetecek kadar detay var; fotogrametri bu objede iyi sonuç verir.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is enough surface detail to match on; photogrammetry will do well on this object."
          }
        }
      }
    },
    "dokulu · ölçeksiz": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
