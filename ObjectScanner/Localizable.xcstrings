            "value": "Lock Object"
          }
        }
      }
    },
    "Objeyi adım adım döndür": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotate the object step by step"
          }
        }
      }
    },
    "Objeyi dokulu bir zemine koyup kadrajı sıkı tutun; çok küçük parçalar için masaüstü tarayıcı gerekir.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place the object on a textured surface and frame it tightly; very small parts need a desktop scanner."
          }
        }
      }
    },
    "Objeyi geçici olarak matlaştırın — talk pudrası, kuru şampuan veya mat tarama spreyi belirgin fark yaratır.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporarily dull the object — talcum powder, dry shampoo or matte scanning spray makes a clear difference."
          }
        }
      }
    },
    "Objeyi kadraja alın": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the object into frame"
          }
        }
      }
    },
    "Objeyi kadrajın ortasına alıp kilitleyin: masa ve arka plan elenir, ölçüler objenin olur.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Centre the object in the frame and lock it: the table and background are excluded, and the dimensions become the object's."
          }
        }
      }
    },
    "Objeyi kutunun içine alın": {
      "extractionState": "manual",
      "localizations": {
