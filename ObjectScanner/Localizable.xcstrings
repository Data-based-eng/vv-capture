    "gerçek ölçülerde · renksiz": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "real dimensions · no colour"
          }
        }
      }
    },
    "geçici çözüm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "workaround"
          }
        }
      }
    },
    "iOS SDK'sı cihaz üstü fotogrametride yalnızca `reduced` seviyesini sunuyor. `medium` / `full` / `raw` sadece macOS'ta mevcut.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iOS SDK offers only the `reduced` level for on-device photogrammetry. `medium` / `full` / `raw` exist on macOS only."
          }
        }
      }
    },
    "iOS cihaz üstü fotogrametride tek desteklenen seviye. Daha yüksek poligon için kaynak görüntüleri Mac'e aktarın.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The only level iOS supports for on-device photogrammetry. For a higher polygon count, move the source images to a Mac."
          }
        }
      }
    },
    "obje": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "object"
          }
        }
      }
    },
