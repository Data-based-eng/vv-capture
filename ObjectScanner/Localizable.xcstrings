        }
      }
    },
    "Uygulamayı arka plana almayın — iOS işlemi askıya alır.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not send the app to the background — iOS will suspend the work."
          }
        }
      }
    },
    "Uygulamayı arka plana almayın.": {
