    "%lld fiziksel lens. Aynı modelin iki cihazında bu liste farklıysa eksik olan lens arızalı demektir.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld physical lenses. If this list differs between two units of the same model, the missing lens is faulty."
          }
        }
      }
    },
    "%lld fotoğraf": {
      "extractionState": "manual",
      "localizations": {
