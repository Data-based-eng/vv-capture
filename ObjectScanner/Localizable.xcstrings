    "1 dakikadan az": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "less than a minute"
          }
        }
      }
    },
    "1 m'den büyük": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "larger than 1 m"
          }
        }
      }
    },
    "15 cm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "15 cm"
          }
        }
      }
    },
    "30 cm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "30 cm"
          }
        }
      }
    },
    "30 cm – 1 m": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "30 cm – 1 m"
          }
        }
      }
    },
    "3B baskı. Sadece geometri, materyal taşımaz.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3D printing. Geometry only, no materials."
          }
        }
      }
    },
    "5 cm'den küçük": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "smaller than 5 cm"
          }
        }
      }
    },
    "5 cm'in altındaki objeler her iki sensörün de çözünürlük sınırına girer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Objects under 5 cm hit the resolution limit of both sensors."
          }
        }
      }
    },
    "5 – 30 cm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5 – 30 cm"
          }
        }
      }
    },
    "60 cm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "60 cm"
          }
        }
      }
    },
    "Algılama başlamadı. Cihazı objeye doğrultup tekrar deneyin.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detection did not start. Point the device at the object and try again."
          }
        }
      }
    },
    "Algılamayı Başlat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Detection"
          }
        }
      }
    },
    "Alt yüz eksik kalacak": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The underside will be missing"
          }
        }
      }
    },
    "Alt yüzü de istiyorsanız objeyi çevirip devam edin.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you want the underside too, flip the object and continue."
          }
        }
      }
    },
    "Anladım, Başla": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Got It, Start"
          }
        }
      }
    },
    "Apple ekosistemi, AR Quick Look. Kaynak format — dönüşüm yok.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ecosystem, AR Quick Look. The source format — no conversion."
          }
        }
      }
    },
    "Arka ana kamera bulunamadı. Tarama yapılamaz.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rear main camera found. Scanning is not possible."
          }
        }
      }
    },
    "Arka kamera bulunamadı.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rear camera found."
          }
        }
      }
    },
    "Arka kamera envanteri": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rear camera inventory"
          }
        }
      }
    },
    "Arka kamera • obje döner • telefon sabit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rear camera • object rotates • phone stays put"
          }
        }
      }
    },
    "Arka kamera • sen dönersin • rehberli akış": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rear camera • you orbit • guided flow"
          }
        }
      }
    },
    "Arka kameranın gördüğü ortamda doku yok — poz buradan geliyor, dokulu bir yöne dönün": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No texture in what the rear camera sees — the pose comes from there, so turn toward something textured"
          }
        }
      }
    },
    "Arşiv yazılamadı.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not write the archive."
          }
        }
      }
    },
    "Ayna ve büyük camlara dikkat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch out for mirrors and large glass"
          }
        }
      }
    },
    "Bilgi": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Info"
          }
        }
      }
    },
    "Bir tur doldu — telefonun yüksekliğini veya açısını değiştirip bir tur daha çek": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One full turn done — change the phone's height or angle and shoot another"
          }
        }
      }
    },
    "Bir tur yetmez — yüksekliği değiştir": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One turn is not enough — change the height"
          }
        }
      }
    },
    "Biraz uzaklaşın": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move back a little"
          }
        }
      }
    },
    "Biraz var": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some"
          }
        }
      }
    },
    "Biraz yaklaşın — detay belirgin artar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move a little closer — detail improves noticeably"
          }
        }
      }
    },
    "Birinci turda telefonu duvarlara doğru tut. İkinci turda biraz aşağı eğ, zemini ve mobilyanın önünü gör. Tek tur yeterli kare bırakmıyor ve model yırtık çıkıyor.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the first loop hold the phone toward the walls. On the second, tilt it down to see the floor and the fronts of the furniture. A single loop does not leave enough frames and the model comes out torn."
          }
        }
      }
    },
    "Bitir ve Kaydet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish and Save"
          }
        }
      }
    },
    "Bitir ve Modeli Oluştur": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish and Build Model"
          }
        }
      }
    },
    "Bitti": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        }
      }
    },
    "Bol desen / doku": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rich pattern / texture"
          }
        }
      }
    },
    "Boyut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Size"
          }
        }
      }
    },
    "Bu cihaz cihaz-üstü fotogrametriyi desteklemiyor.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device does not support on-device photogrammetry."
          }
        }
      }
    },
    "Bu cihaz ön kamerayla dünya takibini desteklemiyor. Poz bilgisi olmadan tarama birleştirilemez.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device does not support world tracking with the front camera. Without pose data the scan cannot be fused."
          }
        }
      }
    },
    "Bu cihazda fotoğraflara derinlik gömülemiyor — model gerçek boyutta olmayacak, ölçeksiz çıkacak.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device cannot embed depth in photos — the model will have no real-world scale."
          }
        }
      }
    },
    "Bu format materyal/texture taşımaz — sadece geometri.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This format carries no materials or textures — geometry only."
          }
        }
      }
    },
    "Bu mod henüz gelmedi (Faz 2).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This mode is not available yet (Phase 2)."
          }
        }
      }
    },
    "Bu mod odanın yapısını çıkarır: duvarlar, kapılar, pencereler ve mobilya. Mobilya tanınmış kutular olarak gelir — koltuğun kumaş kıvrımlarını değil. Detaylı obje modeli için Fotogrametri modunu kullan.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This mode captures the room's structure: walls, doors, windows and furniture. Furniture arrives as recognised boxes — not the folds in the sofa fabric. For a detailed object model, use Photogrammetry."
          }
        }
      }
    },
    "Bu ne demek?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What does this mean?"
          }
        }
      }
    },
    "Bu obje için doğru araç TrueDepth modu, ancak o mod henüz gelmedi (Faz 2).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TrueDepth is the right tool for this object, but that mode is not available yet (Phase 2)."
          }
        }
      }
    },
    "Bu obje çevrilerek taranamaz — yörüngeye devam edin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This object cannot be scanned flipped — keep orbiting"
          }
        }
      }
    },
    "Bu obje çevrilerek taranamıyor — farklı yükseklikten yeni bir yörünge çekebilirsiniz.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This object cannot be scanned flipped — you can shoot another orbit from a different height."
          }
        }
      }
    },
    "Bu üç cevap hangi sensörün doğru olduğunu belirler. En kritik olan desen: fotogrametri geometriyi yüzey deseninden üretir.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These three answers decide which sensor is right. Pattern matters most: photogrammetry derives geometry from surface detail."
          }
        }
      }
    },
    "Bulanık kare atlandı — daha yavaş çevirin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blurry frame skipped — rotate more slowly"
          }
        }
      }
    },
    "Bulut objenin aynası gibi çıkıyorsa bunu açın. Değiştirmek taramayı sıfırlar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn this on if the cloud comes out mirrored. Changing it resets the scan."
          }
        }
      }
    },
    "Bölgeyi Aç": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock Region"
          }
        }
      }
    },
    "Büyük objede tek geçiş yetmez: farklı yüksekliklerde 2-3 yörünge çekin.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One pass is not enough on a large object: shoot 2-3 orbits at different heights."
          }
        }
      }
    },
    "Cihaz yetenekleri": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device capabilities"
          }
        }
      }
    },
    "Cihaz üstü (reduced)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device (reduced)"
          }
        }
      }
    },
    "Cihaz üstü model `reduced` seviyede. Aynı görüntüleri bir Mac'te `detail: .full` veya `.raw` ile işlerseniz belirgin şekilde yüksek poligonlu mesh alırsınız. Görüntüleri silerseniz bu yol kapanır.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The on-device model is at `reduced`. Processing the same images on a Mac with `detail: .full` or `.raw` yields a substantially higher-poly mesh. Deleting the images closes that path."
          }
        }
      }
    },
    "Cihaz üstü yeniden yapılandırma: reduced": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device reconstruction: reduced"
          }
        }
      }
    },
    "Cihazı objeye doğrultun": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point the device at the object"
          }
        }
      }
    },
    "Daha yavaş hareket ettirin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move more slowly"
          }
        }
      }
    },
    "Deneysel. Fotogrametri geometriyi yüzey deseninden türetir; boş boyalı duvarlarda zayıf kalır, mobilyalı ve dokulu odalarda iyi çıkar. Ayrıca oda modelinden sonra birkaç dakika daha işlem sürer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental. Photogrammetry derives geometry from surface detail, so it struggles on bare painted walls and does well in furnished, textured rooms. It also adds a few minutes of processing after the room model."
          }
        }
      }
    },
    "Desen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pattern"
          }
        }
      }
    },
    "Desensiz yüzeyde fotogrametri zorlanır, ama şu an mevcut olan tek mod bu.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photogrammetry struggles on a featureless surface, but it is the only mode available right now."
          }
        }
      }
    },
    "Donanım uyarısı": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hardware warning"
          }
        }
      }
    },
    "Duvar, kapı, pencere ve mobilya temiz kutular olarak çıkar. Dosya küçük, Blender'da düzenlemesi kolay — kat planı ve ölçü almak için doğru seçim.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walls, doors, windows and furniture come out as clean boxes. Small file, easy to edit in Blender — the right choice for floor plans and measurements."
          }
        }
      }
    },
    "Duvarlardan 1-2 metre uzakta dolaş": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk 1-2 metres away from the walls"
          }
        }
      }
    },
    "Duvarların çevresinde yavaşça dolaş — çizgiler oluştukça o yüzey yakalanıyor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk slowly around the walls — as the lines appear, that surface is being captured"
          }
        }
      }
    },
    "Duvarı LiDAR ölçer ama 'bu bir kapı' kararını kamera görüntüsü verir. Karanlıkta sınıflandırma çalışmaz.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiDAR measures the wall, but the camera image is what decides \"this is a door\". Classification does not work in the dark."
          }
        }
      }
    },
    "Döndürmek için sürükleyin, yakınlaşmak için iki parmak.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to rotate, pinch to zoom."
          }
        }
      }
    },
    "Döner Tabla": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turntable"
          }
        }
      }
    },
    "Döner tabla kurulumu": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turntable setup"
          }
        }
      }
    },
    "Döner tabla modu bu boyutta işe yarar: telefonu sabitleyip objeyi çevirmek daha kararlı sonuç verir. Düz, desensiz bir arka plan şart.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turntable mode works at this size: fixing the phone and rotating the object gives a more stable result. A plain, featureless background is essential."
          }
        }
      }
    },
    "Düz tek renk": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flat single colour"
          }
        }
      }
    },
    "Dışa Aktar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export"
          }
        }
      }
    },
    "Dışa aktarma": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export"
          }
        }
      }
    },
    "Etrafında dönerken ışık objeye göre sabit kalır. Objeyi çevirdiğinde gölge yüzeyin üzerinde kayar ve çözücü aynı noktayı iki karede tanıyamaz. Tek lamba yerine dağınık ışık kullan; mümkünse lambayı objeyle birlikte döndür.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you orbit, the light stays fixed relative to the object. When you rotate the object, the shading slides across its surface and the solver cannot recognise the same point in two frames. Use diffuse light instead of a single lamp; if you can, rotate the lamp with the object."
          }
        }
      }
    },
    "Format": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Format"
          }
        }
      }
    },
    "Fotogrametri": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photogrammetry"
          }
        }
      }
    },
    "Fotogrametri (cihaz üstü)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photogrammetry (on-device)"
          }
        }
      }
    },
    "Fotoğraf verisi alınamadı.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the photo data."
          }
        }
      }
